[Unit]
Description=TVLens private Tailscale companion server
Wants=network-online.target
After=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=tvlens
Group=tvlens
WorkingDirectory=/opt/tvlens/app
Environment=HOME=/var/lib/tvlens
Environment=CODEX_HOME=/var/lib/tvlens/.codex
Environment=TVLENS_CONFIG=/etc/tvlens/server.env
Environment=TVLENS_SERVER_DATA=/var/lib/tvlens/data
Environment=TVLENS_CODEX_BINARY=/opt/tvlens/codex/node_modules/.bin/codex
Environment=TVLENS_BIND=127.0.0.1
Environment=TVLENS_USAGE_DIR=/var/lib/tvlens/usage
EnvironmentFile=/etc/tvlens/runtime.env
Environment=TVLENS_PORT=8787
Environment=PATH=/opt/tvlens/codex/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/tvlens/app/server/main.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tvlens
MemoryHigh=1500M
MemoryMax=2G
CPUQuota=200%
# Every THREAD of every process of the service counts against this limit, and each Codex role is a child process
# of its own (npm launcher, native binary, sandbox helper). Measured on a 2-vCPU server on 2026-10-13, Codex
# 0.158.0, no model turn: five roles connected at once hold 163 tasks, nine hold 347 (about 38 each).
# The server keeps at most seven roles alive (chat, passage description, re-examination, surveillance reading,
# one to three verification workers; five with the default single worker). A surveillance stopped and started
# again leaves the two or more closing roles next to the new ones for a few seconds: nine process trees at the
# worst, next to Node, Whisper and ffmpeg. The limit covers that peak, not only the seven.
# With 128, starting a surveillance was enough: the kernel refused a fork ("fork rejected by pids controller"),
# and with no task left the image library of the server process crashed it (SIGSEGV, reproduced in isolation);
# the server restarted without its session. With 256, nine do not fit either (8 of 9 connected, 138 refusals).
# Check a running service with: systemctl show tvlens -p TasksCurrent -p TasksMax ; cat <cgroup>/pids.events
TasksMax=512

[Install]
WantedBy=multi-user.target
