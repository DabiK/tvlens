TVLENS_CODEX_AUTH_HOME=/var/lib/tvlens/.codex
TVLENS_WHISPER_MODEL=/opt/tvlens/models/ggml-base.bin
TVLENS_WHISPER_BINARY=/opt/tvlens/whisper/build/bin/whisper-cli
TVLENS_FFMPEG=/usr/bin/ffmpeg
TVLENS_USAGE_DIR=/var/lib/tvlens/usage
# Optional: embeddings only. Never commit the real configuration.
OPENROUTER_API_KEY=

# Optional: adapt to CPU quota; defaults to available CPUs capped at 4.
# TVLENS_WHISPER_THREADS=2

# Optional: visual description during a question. Default 1 (it goes on, one call at a time: a
# question may now run five minutes). 0 withholds it until the question ends, as before 2026-10-13.
# TVLENS_VISION_DURING_ASK=1

# NOT read from this file. The host settings below are read from the service environment only:
# write them in /etc/tvlens/runtime.env (EnvironmentFile of the unit). Written here they are
# silently ignored. Defaults shown; a mistyped value stops the start with a message.
#   TVLENS_QUESTION_TIMEOUT_MS=300000   processing ceiling of a question, 1..300000 ms, queue wait apart
#   TVLENS_DISK_MIN_FREE_MB=1024        free-space floor: below it capture is refused, nothing is deleted
#   TVLENS_DISK_WARN_FREE_MB=2048       "low space" warning threshold
#   TVLENS_SURVEILLANCE_WORKERS=1       surveillance checks in parallel, 1..3
# Codex confinement settings (TVLENS_CODEX_*, TVLENS_COMPANION_PROMPT) are read from the service
# environment too: see deploy/runtime.env.example and SECURITY.md before setting any of them.
