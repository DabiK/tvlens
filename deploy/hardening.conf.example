# Optional systemd drop-in for the TVLens server: defence in depth around the Node process and the
# Codex children it starts. EXAMPLE ONLY: it is not installed by anything in this repository and has
# not been tried on a server. Test it on a copy of the unit before relying on it.
#
#   sudo install -d /etc/systemd/system/tvlens.service.d
#   sudo install -m 0644 deploy/hardening.conf.example /etc/systemd/system/tvlens.service.d/hardening.conf
#   sudo systemctl daemon-reload && sudo systemctl restart tvlens
#   systemd-analyze security tvlens        # reads back what is really applied
#
# What it does not change: the service account still reads its own secrets (/etc/tvlens/server.env,
# the device token, the Codex auth file) and its own session data. The Codex roles are confined by
# the application (no execution environment on a thread, allow-lists); this file only limits what
# the whole service could touch if that failed.

[Service]
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
# AF_NETLINK: Node reads the network interfaces; AF_UNIX: local sockets of the runtime.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

# Deliberately absent:
# - MemoryDenyWriteExecute=true breaks the JIT of Node.
# - RestrictNamespaces=true would break the Linux sandbox of Codex if a command were ever run.
