# Configuration initiale du service : à mesurer avant de la déclarer optimale.
TVLENS_PERCEPTION_BACKEND=local
TVLENS_QUESTIONS_BACKEND=local
TVLENS_INSPECTION_BACKEND=local
TVLENS_EMBEDDINGS_BACKEND=local
TVLENS_LOCAL_VLM_URL=http://127.0.0.1:11434
TVLENS_LOCAL_VLM_MODEL=gemma3:4b
TVLENS_LOCAL_VLM_NUM_CTX=8192
TVLENS_LOCAL_VLM_KEEP_ALIVE=10m
TVLENS_LOCAL_QUESTIONS_URL=http://127.0.0.1:11434
TVLENS_LOCAL_QUESTIONS_MODEL=qwen3.8:27b
TVLENS_LOCAL_QUESTIONS_NUM_CTX=16384
TVLENS_LOCAL_QUESTIONS_KEEP_ALIVE=10m
TVLENS_LOCAL_QUESTIONS_THINK=off
TVLENS_LOCAL_INSPECTION_URL=http://127.0.0.1:11434
TVLENS_LOCAL_INSPECTION_MODEL=gemma3:4b
TVLENS_LOCAL_INSPECTION_NUM_CTX=8192
TVLENS_LOCAL_INSPECTION_KEEP_ALIVE=10m
TVLENS_LOCAL_EMBEDDINGS_URL=http://127.0.0.1:11434
TVLENS_LOCAL_EMBEDDINGS_MODEL=qwen3-embedding:0.6b
TVLENS_WHISPER_BINARY=/srv/tvlens-gx10/outils/whisper.cpp/build/bin/whisper-cli
TVLENS_WHISPER_MODEL=/srv/tvlens-gx10/poids/ggml-base.bin
TVLENS_WHISPER_THREADS=8
TVLENS_CODEX_BINARY=/usr/bin/false
TVLENS_DISK_MIN_FREE_MB=40960
TVLENS_DISK_WARN_FREE_MB=61440
