FROM nvcr.io/nvidia/pytorch:26.09-py3@sha256:307c449df7dabed6b36e017a2b2f2e45bdec9dc203b81507111315f1e971de6e
RUN python3 -m pip install --disable-pip-version-check --no-input --no-cache-dir --only-binary=:all: --no-deps transformers==4.52.4 qwen-vl-utils==0.0.11 accelerate==1.8.1 ffmpeg-python==0.2.0 tokenizers==0.21.2 huggingface-hub==0.34.4
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake pkg-config git curl xz-utils ca-certificates python3-dev python3-setuptools && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://ffmpeg.org/releases/ffmpeg-4.4.8.tar.xz -o /tmp/ffmpeg.tar.xz && echo "c73848c4ae283d9eaee7be3b276affbc3543380483555500d0dd2c9b7e1c39c3  /tmp/ffmpeg.tar.xz" | sha256sum -c - && mkdir -p /opt/ffmpeg-source && tar -xJf /tmp/ffmpeg.tar.xz --strip-components=1 -C /opt/ffmpeg-source
RUN cd /opt/ffmpeg-source && ./configure --prefix=/opt/ffmpeg4 --enable-shared --disable-static --disable-programs --disable-doc --disable-debug --disable-autodetect --enable-pic && make -j4 && make install && echo /opt/ffmpeg4/lib > /etc/ld.so.conf.d/tvlens-ffmpeg4.conf && ldconfig
RUN git clone --depth 1 --branch v0.6.0 --recurse-submodules https://github.com/dmlc/decord.git /opt/decord && test "$(git -C /opt/decord rev-parse HEAD)" = "6a3617cef035535193f390f86399dde139fa2a53" && cmake -S /opt/decord -B /opt/decord/build -DUSE_CUDA=0 -DFFMPEG_DIR=/opt/ffmpeg4 -DCMAKE_BUILD_TYPE=Release -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON -DCMAKE_INSTALL_RPATH=/opt/ffmpeg4/lib && cmake --build /opt/decord/build -j4 && cd /opt/decord/python && python3 setup.py bdist_wheel && python3 -m pip install --no-deps dist/decord-0.6.0-*.whl
