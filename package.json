{
  "name": "tvlens",
  "version": "0.1.0",
  "private": true,
  "description": "TVLens — compagnon de visionnage avec mémoire temporelle, chat contextuel et sources",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "node scripts/package.mjs",
    "open:mac": "node scripts/open-mac.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "node scripts/smoke-electron.mjs",
    "test:electron:verify:live": "node scripts/smoke-electron.mjs --live-verifier",
    "test:verify:live": "node scripts/probe-verify.cjs",
    "test:electron:deep:live": "node scripts/smoke-electron.mjs --live-video-agent",
    "mcp": "node mcp/server.cjs",
    "setup:codex": "node scripts/setup-codex.cjs",
    "test:electron:full:live": "node scripts/smoke-electron.mjs --live-video-agent --live-inspection",
    "test:retrieval:live": "node --env-file=.env.local scripts/probe-retrieval.cjs",
    "test:electron:sheets": "node scripts/smoke-electron.mjs --local-inspection --inspection-strategy=sheets-crop",
    "setup:speech": "node scripts/setup-speech.mjs",
    "test:codex-speed:live": "node scripts/probe-codex-speed.cjs",
    "screenshots:live": "node scripts/capture-showcase.mjs",
    "start:server": "node server/main.cjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "loop": "node scripts/loop/run.mjs",
    "loop:web": "node scripts/loop-web.mjs",
    "lint": "eslint .",
    "ci:check": "node scripts/ci-check.mjs",
    "build:info": "node scripts/build-info.mjs",
    "verify:mac": "node scripts/verify-package.mjs",
    "test:electron:identity": "node scripts/smoke-build-info.mjs",
    "test:electron:setup": "node scripts/smoke-setup.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "9.39.5",
    "electron": "^44.4.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.8.1",
    "@electron/asar": "4.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.14",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24"
  }
}
