# OpenRouter sert uniquement aux embeddings dans l’application actuelle.
OPENROUTER_API_KEY=
# Codex utilise son authentification locale : aucune clé Codex dans ce fichier.
# TVLENS_CODEX_AUTH_HOME=/chemin/vers/le/dossier/codex
# TVLENS_WHISPER_MODEL=/chemin/ggml-base.bin
# TVLENS_WHISPER_BINARY=/opt/homebrew/bin/whisper-cli
# TVLENS_FFMPEG=/opt/homebrew/bin/ffmpeg
# Modèles du chat et de la vision : Réglages IA dans l’application.
# Les scripts historiques OpenRouter de comparaison acceptent aussi
# OPENROUTER_MODEL et TVLENS_INSPECTION_MODEL ; l’app ne les utilise plus pour la vision.
# Executables are discovered through PATH; explicit paths override discovery.
# TVLENS_CODEX_BINARY=/path/to/codex
# Optional writable directory for usage ledgers (recommended for server deployments).
# TVLENS_USAGE_DIR=/path/to/private/usage

# --- Réglages lus dans ce fichier (ou dans l’environnement, qui l’emporte) ---
# Description visuelle pendant une question. Défaut : 1 (elle continue, un appel à la fois).
# 0 la retient jusqu’à la fin de la question, comme avant le 13 octobre 2026.
# TVLENS_VISION_DURING_ASK=1
# Indexation des passages en arrière-plan quand une clé d’embeddings est configurée. Défaut : 1.
# TVLENS_BACKGROUND_INDEX=1

# --- Réglages d’hôte : lus dans l’ENVIRONNEMENT DU PROCESSUS seulement ---
# Écrits dans ce fichier (.env.local), ils sont ignorés sans message. Les exporter dans le
# terminal avant `npm start` ou `npm run start:server` ; sur un serveur systemd, les écrire
# dans /etc/tvlens/runtime.env. L’application Mac empaquetée ne les reçoit pas.
# Les valeurs ci-dessous sont les défauts. Une valeur mal saisie arrête le démarrage.
#
# Plafond de traitement d’une question, hors attente en file : 1 à 300000 ms.
# Ne peut qu’être abaissé (par exemple 60000 pour l’ancien plafond).
# TVLENS_QUESTION_TIMEOUT_MS=300000
#
# Conservation des médias. Absent : jusqu’à la suppression de la session.
# Une durée positive en millisecondes rétablit la fenêtre glissante (300000 = cinq minutes).
# TVLENS_MEDIA_RETENTION_MS=
#
# Espace libre du volume des sessions, en mégaoctets. Sous le plancher, la capture est
# refusée et rien n’est supprimé ; sous le seuil d’alerte, l’état dit « espace faible ».
# TVLENS_DISK_MIN_FREE_MB=1024
# TVLENS_DISK_WARN_FREE_MB=2048
#
# Vérifications de surveillance en parallèle : 1 à 3.
# TVLENS_SURVEILLANCE_WORKERS=1

# --- Cloisonnement des agents Codex : environnement du processus seulement ---
# TVLENS_CODEX_CONFINEMENT règle la sévérité du contrôle à l’ouverture d’un fil.
# TVLENS_CODEX_ITEM_GUARD, TVLENS_CODEX_REAL_HOME et TVLENS_COMPANION_PROMPT sont des replis
# de diagnostic : chacun retire un contrôle.
# Valeurs, effets et risques : SECURITY.md et deploy/runtime.env.example. Ne rien poser sans les lire.
